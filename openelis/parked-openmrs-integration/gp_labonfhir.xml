<config>
    <globalProperties>
        <!-- OpenELIS LIS integration (labonfhir module, see openelis/ in this repo).
             OpenMRS pushes TestOrders to, and polls results from, the co-resident
             OpenELIS external-fhir-api HAPI store over mutual TLS (SSL). -->
        <globalProperty>
            <property>labonfhir.lisUrl</property>
            <value>https://fhir.openelis.org:8443/fhir/</value>
        </globalProperty>
        <globalProperty>
            <property>labonfhir.lisUserUuid</property>
            <value>	</value>
        </globalProperty>
        <globalProperty>
            <property>labonfhir.keystorePath</property>
            <value>/etc/openelis-global/keystore</value>
        </globalProperty>
        <globalProperty>
            <property>labonfhir.keystorepassword</property>
            <value>kspass</value>
        </globalProperty>
        <globalProperty>
            <property>labonfhir.truststorePath</property>
            <value>/etc/openelis-global/truststore</value>
        </globalProperty>
        <globalProperty>
            <property>labonfhir.truststorepassword</property>
            <value>tspass</value>
        </globalProperty>
        <globalProperty>
            <property>labonfhir.activateFhirPush</property>
            <value>true</value>
        </globalProperty>
        <globalProperty>
            <property>labonfhir.authType</property>
            <value>SSL</value>
        </globalProperty>
        <globalProperty>
            <property>labonfhir.openmrsPatientIdentifier.uuid</property>
            <!-- National ID Number -->
            <value>eb201574-8abe-4393-9a8a-8d30a48a08ad</value>
        </globalProperty>
        <globalProperty>
            <property>labonfhir.lisIdentifierSystem.url</property>
            <value>http://openelis-global.org/pat_nationalId</value>
        </globalProperty>
        <globalProperty>
            <property>labonfhir.orderTestUuids</property>
            <value></value>
        </globalProperty>
        <globalProperty>
            <property>labonfhir.labUpdateTriggerObject</property>
            <value>Order</value>
        </globalProperty>
        <globalProperty>
            <property>labonfhir.addObsAsTaskInput</property>
            <value>false</value>
        </globalProperty>
        <globalProperty>
            <property>labonfhir.filterOrderBytestUuids</property>
            <value>false</value>
        </globalProperty>
        <globalProperty>
            <property>labonfhir.filterDemoData</property>
            <value>true</value>
        </globalProperty>
    </globalProperties>
</config>